/*
  Dear Data 100 - Valorant Rounds
  Creative Coding - Part 1

  This sketch reads my CSV file of 100 Valorant rounds.
  Each row is one round.

  My first visual idea was to use circles.
  This version shows an early circle concept.
*/

Table rounds;                 
int currentRound = 0;         
int totalWins = 0;            
float averageMoodChange = 0;  

void setup() {
  size(1050, 680);

  // Load the CSV from the data folder
  rounds = loadTable("valorant_rounds_001-100.csv", "header");

  // Only do calculations if the file loaded properly
  if (rounds != null && rounds.getRowCount() > 0) {
    totalWins = countWins(rounds);
    averageMoodChange = findAverageMoodChange(rounds);
  }
}

// Counts how many rows have "Win" in the result column
int countWins(Table data) {
  int wins = 0;

  for (TableRow row : data.rows()) {
    if (row.getString("result").equalsIgnoreCase("Win")) {
      wins++;
    }
  }

  return wins;
}

// Works out the average mood change across all rounds
float findAverageMoodChange(Table data) {
  float total = 0;

  for (TableRow row : data.rows()) {
    int before = row.getInt("moodBefore");
    int after = row.getInt("moodAfter");
    total += (after - before);
  }

  return total / data.getRowCount();
}

void draw() {
  background(15, 30, 50);

  fill(235, 245, 255);
  textSize(30);
  text("Dear Data 100 - Valorant", 40, 60);

  textSize(16);
  text("My first visual idea: circles", 40, 95);

  // If the file didn't load, show a message
  if (rounds == null || rounds.getRowCount() == 0) {
    fill(255, 150, 150);
    text("CSV file not found. Check the data folder.", 40, 160);
    return;
  }

  // Summary information
  fill(185, 215, 235);
  textSize(18);
  text("Rounds collected: " + rounds.getRowCount(), 40, 155);
  text("Rounds won: " + totalWins, 40, 185);
  text("Average mood change: " + nf(averageMoodChange, 1, 2), 40, 215);

  // Get the currently selected row
  TableRow selected = rounds.getRow(currentRound);

  // Draw the circle visual
  drawCircleIdea(selected);

  // Show the data values on the right
  showRoundDetails(selected);

  fill(180, 210, 230);
  textSize(15);
  text("Use the LEFT and RIGHT arrow keys to change rounds.", 40, 640);
}

// Draws my first idea using circles
void drawCircleIdea(TableRow row) {
  pushMatrix();
  translate(310, 420);

  int kills = row.getInt("kills");
  int deaths = row.getInt("deaths");
  int moodBefore = row.getInt("moodBefore");
  int moodAfter = row.getInt("moodAfter");
  String result = row.getString("result");

  // Main circle size is based on kills
  float mainSize = 80 + kills * 18;

  // Second circle size is based on deaths
  float secondSize = 50 + deaths * 18;

  // Mood change decides another circle size
  float moodSize = 40 + abs(moodAfter - moodBefore) * 20;

  noStroke();

  // Result decides the main colour
  if (result.equalsIgnoreCase("Win")) {
    fill(110, 220, 195, 180);
  } else {
    fill(255, 165, 180, 180);
  }
  ellipse(0, 0, mainSize, mainSize);

  // Deaths circle
  fill(170, 210, 255, 170);
  ellipse(-55, 40, secondSize, secondSize);

  // Mood change circle
  fill(255, 230, 150, 170);
  ellipse(60, -35, moodSize, moodSize);

  // Small centre circle
  fill(240, 245, 255);
  ellipse(0, 0, 22, 22);

  // Small labels near the circles
  fill(235, 245, 255);
  textSize(14);
  text("kills", -18, -mainSize/2 - 12);
  text("deaths", -88, 95);
  text("mood", 45, -70);

  popMatrix();
}

// Shows the round information in text form
void showRoundDetails(TableRow row) {
  fill(25, 50, 75);
  noStroke();
  rect(590, 250, 410, 350, 12);

  fill(235, 245, 255);
  textSize(24);
  text("Round " + row.getInt("observation"), 615, 290);

  textSize(17);
  text("Date: " + row.getString("date"), 615, 335);
  text("Map: " + row.getString("map"), 615, 370);
  text("Agent: " + row.getString("agent"), 615, 405);
  text("Result: " + row.getString("result"), 615, 440);

  text("Kills: " + row.getInt("kills")
    + "    Deaths: " + row.getInt("deaths"), 615, 475);

  text("Music: " + row.getString("musicPlaying"), 615, 510);
  text("Genre: " + row.getString("musicGenre"), 615, 545);

  text("Mood: " + row.getInt("moodBefore")
    + " to " + row.getInt("moodAfter"), 615, 580);
}

// Lets me browse through rounds with the keyboard
void keyPressed() {
  if (rounds == null || rounds.getRowCount() == 0) {
    return;
  }

  if (keyCode == RIGHT) {
    currentRound++;
    if (currentRound >= rounds.getRowCount()) {
      currentRound = 0;
    }
  }

  if (keyCode == LEFT) {
    currentRound--;
    if (currentRound < 0) {
      currentRound = rounds.getRowCount() - 1;
    }
  }
}
